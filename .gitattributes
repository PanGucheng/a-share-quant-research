# Qlib execution evidence manifests bind the CRLF bytes emitted by the audited
# Windows runtime. Recreate those exact bytes on every checkout, including CI.
outputs/qlib_exchange_split_transparent_v1/** text eol=crlf

# This frozen study records Windows CSV bytes but an LF Markdown report.
# Preserve its manifest hashes consistently on every CI checkout.
reports/historical_dataset_validation_design_v1/*.csv text eol=crlf
reports/historical_dataset_validation_design_v1/*.md text eol=lf

# Performance execution profiles re-hash the exact Windows-emitted evidence bytes.
reports/performance_execution_v1/** binary

# The execution config embeds the raw SHA-256 of this canonical semantics file.
configs/qlib_exchange_semantics_669_v1.yaml text eol=lf

# Frozen model binaries/config payloads are byte-addressed and must never
# receive checkout-time newline conversion.
artifacts/prospective_forward_candidate_v1/** binary
outputs/external_pit_style_data_v1/current/external_pit_style_data.parquet filter=lfs diff=lfs merge=lfs -text
