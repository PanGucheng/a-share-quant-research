# Runtime outputs are ignored by default. Files already tracked by Git remain
# tracked; do not use this policy as a reason to untrack historical evidence.
outputs/**

# Genuine Forward evidence is append-only and remains eligible for tracking.
!outputs/forward/
!outputs/forward/**

# Forward intermediates are runtime data, not official evidence.
outputs/forward/dry_run/**
outputs/forward/metrics/**
outputs/forward/**/runtime/**
outputs/forward/predictions/*/raw.csv
outputs/forward/predictions/*/features.csv
outputs/forward/predictions/*/prediction_pending_receipt.json

# Cache, downloads, scratch data, and interrupted-run noise.
tmp/
*.tmp
.delegate/
data/forward/

# Logs are runtime data. Historical logs already tracked by Git remain tracked.
logs/*.log

# Local Python, package, configuration, editor, and OS noise.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
configs/project.local.yaml
.vscode/
.idea/
Thumbs.db
Desktop.ini
