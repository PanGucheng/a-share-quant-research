# Runtime outputs are ignored by default. Files already tracked by Git remain
# tracked; do not use this policy as a reason to untrack historical evidence.
outputs/**

# Forward is ignored by default. Re-include only the directories needed to reach
# the explicit append-only official evidence allowlist below.
!outputs/forward/
!outputs/forward/status.json
!outputs/forward/predictions/
!outputs/forward/predictions/*/
!outputs/forward/predictions/*/prediction.csv
!outputs/forward/predictions/*/prediction_receipt.json
!outputs/forward/paper_portfolio/
!outputs/forward/paper_portfolio/status.json
!outputs/forward/paper_portfolio/decisions/
!outputs/forward/paper_portfolio/decisions/*/
!outputs/forward/paper_portfolio/decisions/*/decision.json
!outputs/forward/paper_portfolio/decisions/*/target_weights.csv

# Cache, downloads, scratch data, and interrupted-run noise.
tmp/
*.tmp
.delegate/
data/forward/

# Logs are runtime data. Historical logs already tracked by Git remain tracked.
logs/*.log

# Local Python, package, configuration, editor, and OS noise.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
configs/project.local.yaml
.vscode/
.idea/
Thumbs.db
Desktop.ini
